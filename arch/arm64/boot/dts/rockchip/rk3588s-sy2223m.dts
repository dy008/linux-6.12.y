	status = "okay";
	assigned-clocks = <&cru CLK_SPI3>;
	assigned-clock-rates = <200000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi3m1_cs0 &spi3m1_pins>;
	rx-sample-delay-ns = <0x0f>;

	icm42652@0 {
